# ─────────────────────────────────────────────
# ZeroQ — Environment Variables Template
# Copy to .env.local and fill in real values.
# ─────────────────────────────────────────────

# ── Oracle Database ───────────────────────────
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=FREEPDB1
DB_USER=zerq_app
DB_PASSWORD=ZeroQ_App1

# Full JDBC connection string (for Java/JDBC clients)
DB_JDBC_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1

# node-oracledb / oracledb connection string
DB_CONNECTION_STRING=localhost:1521/FREEPDB1

# ── Next.js ───────────────────────────────────
NEXT_PUBLIC_APP_NAME=ZeroQ
NODE_ENV=development

# ── Polling interval for live order updates (ms) ──
NEXT_PUBLIC_POLL_INTERVAL_MS=3000
