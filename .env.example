# ========================
# ZeroQ Environment Variables
# ========================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.

# ----- Database (Supabase PostgreSQL) -----
# Connection pooling URL (used by Prisma at runtime via PgBouncer)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection URL (used by Prisma for migrations)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].supabase.com:5432/postgres"

# ----- NextAuth.js -----
# Generate a strong random secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
# Local development URL (change to production URL before deploying)
NEXTAUTH_URL="http://localhost:3000"

# ----- Razorpay Payment Gateway (Test / Sandbox Mode) -----
# Server-side key (keep private — never expose to client)
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret-here"
# Client-side public key (prefixed with NEXT_PUBLIC_ to expose to browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXXXXXXXX"
